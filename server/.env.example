# SideBuilds server environment — copy to .env and fill in your own values.
# Never commit the real .env file.

# --- Database ---
# Postgres connection string (Supabase: use the transaction pooler, port 6543)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
DB_SSL=true

# Set to 'true' only for local SQLite development (NODE_ENV must be 'development')
USE_SQLITE=false

# --- Server ---
NODE_ENV=development
PORT=5002
CLIENT_URL=http://localhost:3002

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-hex-string

# --- Stripe (secret keys stay ONLY on the server) ---
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_ACCOUNT_TYPE=express

# Platform commission percentage taken from each sale
COMMISSION_RATE=5

# --- Email (optional in development; required for password reset in production) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# --- AI features (optional) ---
OPENAI_API_KEY=

# --- Logging ---
LOG_LEVEL=info
ENABLE_QUERY_LOGGING=false
