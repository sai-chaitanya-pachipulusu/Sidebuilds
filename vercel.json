{
  "version": 2,
  "buildCommand": "cd client && npm run build",
  "outputDirectory": "client/build",
  "installCommand": "npm install && cd client && npm install",
  // Legacy builds config (replaced with modern commands above)
  // "builds": [
  //   { 
  //     "src": "client/package.json", 
  //     "use": "@vercel/static-build",
  //     "config": { 
  //       "distDir": "build",
  //       "framework": "create-react-app"
  //     }
  //   }
  // ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://sidebuilds-api.onrender.com/api/$1"
    },
    { 
      "src": "/static/(.*)", 
      "dest": "/client/static/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    { 
      "src": "/favicon.ico", 
      "dest": "/client/favicon.ico",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    { 
      "src": "/logo(.*).png", 
      "dest": "/client/logo$1.png",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    { 
      "src": "/asset-manifest.json", 
      "dest": "/client/asset-manifest.json",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    { 
      "src": "/manifest.json", 
      "dest": "/client/manifest.json",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    { 
      "src": "/(.*)", 
      "dest": "/client/index.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://sidebuilds-api.onrender.com/api/$1"
    }
  ],
  // "functions": {
  //   "client/build/static/js/*.js": {
  //     "maxDuration": 10
  //   }
  // },
  // "regions": ["iad1"], // Commented out - may not be supported on all plans
  "framework": "create-react-app"
} 