{
  "version": 2,
  "name": "sidebuilds-frontend",
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://sidebuilds-api.onrender.com/api/$1"
    },
    {
      "src": "/socket.io/(.*)",
      "dest": "https://sidebuilds-api.onrender.com/socket.io/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}