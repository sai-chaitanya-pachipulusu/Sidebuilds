{
  "name": "sideproject-tracker",
  "version": "2.0.0",
  "description": "A SaaS marketplace for side projects.",
  "private": true,
  "scripts": {
    "server": "npm start --prefix server",
    "client": "npm start --prefix client",
    "dev": "node dev-start.js",
    "dev-old": "concurrently \"cd server && npm run dev\" \"cd client && npm start\"",
    "dev-clean": "node cleanup-ports.js && node dev-start.js",
    "restart": "node restart-servers.js",
    "kill-ports": "node kill-ports.js",
    "cleanup-ports": "node cleanup-ports.js",
    "setup": "node setup-environment.js",
    "setup-db": "node setup-database.js",
    "db:migrate": "node database/run-unified-migration.js",
    "db:verify": "node database/run-unified-migration.js --verify-only",
    "db:cleanup": "node database/run-unified-migration.js --cleanup",
    "test-db": "node test-database-connection.js",
    "test-server": "node test-server-startup.js",
    "start": "concurrently \"cd server && npm start\" \"cd client && npm start\"",
    "start-clean": "node kill-ports.js && npm start",
    "install-all": "npm install && cd server && npm install && cd client && npm install",
    "validate-build": "node scripts/validate-build.js",
    "build:client:win": "cd client && npm run build:production:win",
    "build:client": "cd client && npm run build:vercel-deploy",
    "deploy:validate": "npm run validate-build && npm run build:client",
    "deploy:vercel": "cd client && vercel --prod",
    "build:win": "cd client && npm run build:production:win",
    "build": "cd client && npm run build:vercel-deploy",
    "install": "cd client && npm install",
    "vercel-build": "cd client && npm run build:vercel-deploy && node scripts/package-hosting.cjs"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.5.0",
    "pg": "^8.15.6",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
